VITE_API_BASE_URL=

# Leave VITE_API_BASE_URL empty so browser calls stay same-origin via Vite proxy.
# Point proxy at Laravel (hris-be-rilt13: php artisan serve → :8000).
# Legacy Nest/Java BE was :3000.
VITE_DEV_PROXY_TARGET=http://localhost:8000
VITE_APP_ENV=development
VITE_APP_DSN=

# Payment providers are configured on the backend (STRIPE_*, PAYPAL_*, TWOC2P_*).
